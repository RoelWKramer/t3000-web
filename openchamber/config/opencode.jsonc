{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai"],
  "model": "openai/deepseek-v4-pro",
  "small_model": "openai/deepseek-v4-pro",
  "references": {
    "opencode-server": {
      "path": "/home/openchamber/opencode-server"
    }
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push *": "ask",
      "npm *": "allow",
      "grep *": "allow"
    }
  }
}
