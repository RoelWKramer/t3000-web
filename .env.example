# AI Provider (pick one)

# OpenCode Go (https://opencode.ai/auth)
OPENCODE_GO_API_KEY=sk-...

# OpenCode Zen (https://opencode.ai/auth)
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_API_KEY=oc-...

# OpenRouter (https://openrouter.ai/settings/keys)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...

# GitHub
GITHUB_PAT=ghp_...

# Server auth (used by opencode attach)
OPENCODE_SERVER_PASSWORD=change-me

# OpenChamber UI password
OPENCHAMBER_UI_PASSWORD=change-me-too

# Disable opencode automatic updates
OPENCODE_DISABLE_AUTOUPDATE=true

# Your domain (e.g. code.example.com)
DOMAIN=code.example.com

# Comma-separated CIDR ranges for IP whitelist (e.g. 1.2.3.4/32,10.0.0.0/8)
IP_ALLOW=1.2.3.4/32
